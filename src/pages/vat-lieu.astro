---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
const accent = '#FFC928';
const useLabel: Record<string, string> = { kinh: 'Kính, cửa', xe: 'Xe', tuong: 'Tường, nội thất', qua: 'Quà tặng, đồ dùng' };
const mats: any[] = [
      {
        id: 'mau', name: 'Decal màu trơn',
        desc: 'Loại phổ biến nhất, bề mặt đồng màu, có nhiều màu để chọn. Cắt chữ, logo và họa tiết đều tốt, giá dễ tiếp cận. Nếu chưa biết chọn gì, bắt đầu từ loại này.',
        uses: ['kinh', 'xe', 'tuong', 'qua'],
        note: 'Chọn màu tương phản với nền để chữ dễ đọc. Màu quá nhạt trên kính sáng sẽ khó thấy.',
        bg: accent, fg: '#111', effect: 'Màu đồng nhất, không phản chiếu', best: 'Chữ dán kính, tường, tem xe thông thường', rnote: 'Màu nhạt khó đọc trên nền sáng'
      },
      {
        id: 'xi', name: 'Decal xi (ánh kim)',
        desc: 'Bề mặt phản chiếu như kim loại: xi vàng, xi bạc, đồng… Tạo cảm giác sang, nổi bật cho logo, bảng hiệu và tên cửa hàng.',
        uses: ['kinh', 'xe', 'qua'],
        note: 'Hiệu ứng rõ nhất ở chữ lớn, nét đơn giản. Bề mặt bóng dễ thấy vết xước và dấu tay, tránh dán nơi hay chà xát.',
        bg: 'linear-gradient(135deg, #B59A4A 0%, #F3E3A0 50%, #B59A4A 100%)', fg: '#6B5410', effect: 'Bóng, ánh kim loại', best: 'Logo, bảng hiệu, tên cửa hàng', rnote: 'Dễ lộ vết xước, nên dùng chữ lớn'
      },
      {
        id: 'quang', name: 'Decal phản quang',
        desc: 'Phản chiếu ánh đèn khi trời tối nên dễ nhận ra hơn. Thường dùng cho xe dịch vụ, xe tải, thùng hàng và biển cảnh báo.',
        uses: ['xe'],
        note: 'Chọn khi độ dễ thấy ban đêm là yêu cầu chính. Giá thường cao hơn decal trơn, hỏi bên mình để biết giá theo màu.',
        bg: 'repeating-linear-gradient(45deg, #F2F2F2 0 8px, #D4D4D4 8px 16px)', fg: '#111', effect: 'Sáng lên khi có đèn chiếu', best: 'Xe dịch vụ, xe tải, thùng hàng, biển báo', rnote: 'Giá cao hơn, ít màu hơn decal trơn'
      },
      {
        id: 'mo', name: 'Decal mờ dán kính',
        desc: 'Làm kính trông như được phun cát: che bớt tầm nhìn mà vẫn lấy sáng. Hợp với vách kính văn phòng, phòng họp, cửa phòng khám, tiệm làm đẹp.',
        uses: ['kinh'],
        note: 'Chỉ dán lên kính phẳng, sạch. Dán dải liền hoặc họa tiết, cần đo kỹ trước khi cắt.',
        bg: '#6F8E8B', fg: '#fff', dots: true, effect: 'Mờ đục như kính phun cát', best: 'Vách kính văn phòng, phòng họp, cửa kính cần riêng tư', rnote: 'Chỉ dùng cho bề mặt kính phẳng'
      },
      {
        id: 'trong', name: 'Decal trong',
        desc: 'Nền trong suốt để giữ độ nhìn xuyên qua, phù hợp khi muốn chữ hoặc hình nổi lên mà không che mất bề mặt phía sau.',
        uses: ['kinh', 'qua'],
        note: 'Phù hợp khi nền phía sau cần được giữ nguyên. Hỏi bên mình về loại trong có sẵn và khả năng cắt chữ nhỏ.',
        bg: '#E9E2D3', fg: '#111', checker: true, effect: 'Trong suốt', best: 'Kính, mặt nhựa trong, sản phẩm cần giữ nền', rnote: 'Cần hỏi loại và khả năng cắt chữ nhỏ'
      },
      {
        id: 'van', name: 'Decal vân (gỗ, carbon)',
        desc: 'Bề mặt có hoa văn giả gỗ hoặc sợi carbon, dùng để trang trí đồ nội thất, chi tiết xe hoặc đồ dùng cá nhân.',
        uses: ['tuong', 'xe', 'qua'],
        note: 'Hoa văn thấy rõ ở mảng lớn, chữ quá nhỏ sẽ khó nhận ra vân. Bề mặt dán cần phẳng.',
        bg: 'repeating-linear-gradient(90deg, #7A5A3A 0 6px, #8B6A47 6px 12px)', fg: '#FFF9E9', effect: 'Hoa văn gỗ hoặc carbon', best: 'Đồ nội thất, chi tiết trang trí, đồ dùng cá nhân', rnote: 'Hoa văn khó thấy ở chi tiết nhỏ'
      }
    ];
const tabs = [
  { id: 'all', label: 'Tất cả' }, { id: 'kinh', label: 'Kính & cửa' }, { id: 'xe', label: 'Xe' },
  { id: 'tuong', label: 'Tường & nội thất' }, { id: 'qua', label: 'Quà tặng' }
].map((x) => ({ ...x, cls: x.id === 'all' ? 'chip on' : 'chip' }));
const items = mats.map((m) => {
  let bg = m.bg;
  if (m.dots) bg = 'radial-gradient(rgba(255,255,255,0.45) 2px, transparent 2.5px) 0 0 / 12px 12px, ' + m.bg;
  if (m.checker) bg = 'conic-gradient(#D9D2C0 25%, #FFF9E9 0 50%, #D9D2C0 0 75%, #FFF9E9 0) 0 0 / 24px 24px';
  return {
    name: m.name, desc: m.desc, note: m.note,
    uses: m.uses.map((u: string) => useLabel[u]),
    useIds: m.uses.join(' '),
    swatchStyle: 'height: 150px; display: flex; align-items: center; justify-content: center; background: ' + bg,
    swatchTextStyle: 'font-weight: 900; font-size: 56px; letter-spacing: -0.03em; color: ' + m.fg
  };
});
const rows = mats.map((m) => ({ name: m.name, effect: m.effect, best: m.best, note: m.rnote }));
const brandCards = [
        { name: '3M', origin: 'Hoa Kỳ', desc: 'Tập đoàn vật liệu và giải pháp công nghiệp có dòng vật liệu đồ họa cho biển hiệu, quảng cáo và decal dán xe.', fit: 'Biển hiệu, decal dán xe, ứng dụng ngoài trời' },
        { name: 'Avery Dennison', origin: 'Hoa Kỳ', desc: 'Hãng chuyên vật liệu dán nhãn và vật liệu đồ họa, có các dòng decal cắt chữ và decal dán xe, dán kính.', fit: 'Decal cắt chữ, dán xe, dán kính' },
        { name: 'ORACAL', origin: 'Đức', desc: 'Thương hiệu của tập đoàn ORAFOL, quen thuộc với decal cắt chữ bằng máy plotter, có bảng màu trơn đa dạng.', fit: 'Chữ và logo cắt bằng máy, dán kính, tường, xe' },
        { name: '[THƯƠNG HIỆU KHÁC]', origin: '[XUẤT XỨ]', desc: '[MÔ TẢ NGẮN VỀ HÃNG]', fit: '[NƠI DÙNG PHÙ HỢP]' }
      ];
---
<Layout title="Vật liệu decal: màu trơn, xi, phản quang, mờ | CatDecal.vn" description="Hiểu rõ các loại vật liệu decal cắt chữ, nơi dùng phù hợp, lưu ý và các thương hiệu 3M, Avery Dennison, ORACAL." active="materials">

  <!-- Mở đầu -->
  <div style="max-width: 1200px; margin: 0 auto; padding: 32px 24px 24px; display: flex; flex-direction: column; gap: 16px">
    <div style="font-weight: 700; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase">Vật liệu</div>
    <h1 style="margin: 0; font-size: 40px; line-height: 1.08; letter-spacing: -0.035em; font-weight: 900; max-width: 760px">Hiểu rõ vật liệu trước khi đặt cắt.</h1>
    <p style="margin: 0; font-size: 16px; line-height: 1.7; max-width: 660px">Cùng một nội dung chữ, nhưng decal màu, decal xi hay decal phản quang cho kết quả rất khác. Chọn nơi bạn định dán để xem loại phù hợp, rồi gửi file đặt cắt.</p>
  </div>

  <!-- Lọc -->
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px 16px; display: flex; flex-direction: column; gap: 10px">
    <div style="font-weight: 700; font-size: 13px">Bạn định dán ở đâu?</div>
    <div style="display: flex; flex-wrap: wrap; gap: 10px">
      {tabs.map((tab) => (<>
        <button type="button" data-chip data-use={tab.id} class={tab.cls}>{tab.label}</button>
      </>))}
    </div>
  </div>

  <!-- Thẻ vật liệu -->
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px 56px; display: flex; flex-wrap: wrap; gap: 20px">
    {items.map((m) => (<>
      <div data-card data-uses={m.useIds} style="flex: 1 1 340px; min-width: 0; box-sizing: border-box; background: #fff; border-radius: 24px; overflow: hidden; display: flex; flex-direction: column">
        <div style={m.swatchStyle}>
          <span style={m.swatchTextStyle}>Aa</span>
        </div>
        <div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 12px">
          <h2 style="margin: 0; font-size: 20px; letter-spacing: -0.02em; font-weight: 900">{m.name}</h2>
          <div style="font-size: 14px; line-height: 1.7">{m.desc}</div>
          <div style="display: flex; flex-direction: column; gap: 6px">
            <div style="font-weight: 800; font-size: 13px">Hợp với</div>
            <div style="display: flex; flex-wrap: wrap; gap: 8px">
              {m.uses.map((u) => (<>
                <span style="border: 1px solid #111; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 600">{u}</span>
              </>))}
            </div>
          </div>
          <div style="background: #FFF9E9; border-radius: 12px; padding: 12px 14px; font-size: 13px; line-height: 1.6"><b>Lưu ý:</b> {m.note}</div>
          <div style="display: flex; flex-direction: column; gap: 4px; font-size: 13px; line-height: 1.6">
            <div>Màu có sẵn: <b>[DANH SÁCH MÀU]</b></div>
            <div>Dùng ngoài trời: <b>[XÁC NHẬN THEO LOẠI DECAL]</b></div>
            <div>Giá: từ <b>[GIÁ]/m²</b></div>
          </div>
          <a href="/dich-vu/" style="align-self: flex-start; background: #111; color: #FFF9E9; text-decoration: none; font-weight: 700; font-size: 13px; padding: 13px 20px; border-radius: 999px">Đặt cắt loại này</a>
        </div>
      </div>
    </>))}
  </div>

  <!-- So sánh -->
  <div style="background: #fff; padding: 52px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 24px">
      <h2 style="margin: 0; font-size: 30px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">So sánh nhanh</h2>
      <div style="overflow-x: auto; border-radius: 16px; border: 2px solid #111">
        <table style="border-collapse: collapse; width: 100%; min-width: 640px; font-size: 14px; line-height: 1.5">
          <thead>
            <tr style="background: #111; color: #FFF9E9; text-align: left">
              <th style="padding: 14px 16px; font-weight: 700">Loại decal</th>
              <th style="padding: 14px 16px; font-weight: 700">Hiệu ứng</th>
              <th style="padding: 14px 16px; font-weight: 700">Phù hợp nhất</th>
              <th style="padding: 14px 16px; font-weight: 700">Cần lưu ý</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (<>
              <tr style="border-top: 1px solid #E5E1D8; vertical-align: top">
                <td style="padding: 14px 16px; font-weight: 800">{r.name}</td>
                <td style="padding: 14px 16px">{r.effect}</td>
                <td style="padding: 14px 16px">{r.best}</td>
                <td style="padding: 14px 16px">{r.note}</td>
              </tr>
            </>))}
          </tbody>
        </table>
      </div>
      <div style="font-size: 13px; line-height: 1.7">Độ bền ngoài trời, độ dày và màu có sẵn thay đổi theo từng nhà sản xuất. Hỏi bên mình để biết thông số của loại decal đang có.</div>
    </div>
  </div>

  <!-- Thương hiệu -->
  <div id="thuong-hieu" style="padding: 56px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 28px">
      <div style="display: flex; flex-direction: column; gap: 12px; max-width: 720px">
        <div style="font-weight: 700; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase">Thương hiệu</div>
        <h2 style="margin: 0; font-size: 30px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">Các hãng decal bên mình sử dụng</h2>
        <p style="margin: 0; font-size: 15px; line-height: 1.7">Mỗi hãng có nhiều dòng sản phẩm với đặc tính khác nhau. Bên mình tư vấn dòng phù hợp với nơi dán và ngân sách của bạn.</p>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 20px">
        {brandCards.map((b) => (<>
          <div style="flex: 1 1 300px; min-width: 0; box-sizing: border-box; background: #fff; border-radius: 24px; padding: 26px; display: flex; flex-direction: column; gap: 12px">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px">
              <div style="font-weight: 900; font-size: 26px; letter-spacing: -0.03em">{b.name}</div>
              <span style="border: 1px solid #111; border-radius: 999px; padding: 5px 12px; font-size: 12px; font-weight: 700; white-space: nowrap">{b.origin}</span>
            </div>
            <div style="font-size: 14px; line-height: 1.7">{b.desc}</div>
            <div style="background: #FFF9E9; border-radius: 12px; padding: 12px 14px; font-size: 13px; line-height: 1.7">
              <div><b>Phù hợp:</b> {b.fit}</div>
              <div><b>Dòng đang có:</b> [DÒNG SẢN PHẨM]</div>
            </div>
          </div>
        </>))}
      </div>
      <div style="font-size: 13px; line-height: 1.7">Thông số kỹ thuật, độ bền và màu có sẵn do từng nhà sản xuất công bố theo từng dòng. Hỏi bên mình để biết loại đang có và bảng màu.</div>
    </div>
  </div>

  <!-- CTA -->
  <div style="background: #FFC928; padding: 52px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between">
      <div style="flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 10px">
        <h2 style="margin: 0; font-size: 30px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">Chưa chắc nên chọn loại nào?</h2>
        <div style="font-size: 15px; line-height: 1.6">Cho bên mình biết nơi dán và mục đích, bên mình gợi ý chất liệu và báo giá.</div>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 12px">
        <a href="/dich-vu/" style="background: #111; color: #FFF9E9; text-decoration: none; font-weight: 800; font-size: 15px; padding: 16px 28px; border-radius: 999px">Gửi file đặt cắt</a>
        <a href="/blog/chon-chat-lieu/" style="border: 2px solid #111; color: #111; text-decoration: none; font-weight: 700; font-size: 15px; padding: 14px 26px; border-radius: 999px">Đọc bài chọn chất liệu</a>
      </div>
    </div>
  </div>

</Layout>
<script>
  const chips = Array.from(document.querySelectorAll('[data-chip]'));
  const cards = Array.from(document.querySelectorAll('[data-card]'));
  chips.forEach((b) => b.addEventListener('click', () => {
    const u = b.dataset.use;
    chips.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
    cards.forEach((c) => { c.hidden = !(u === 'all' || (c.dataset.uses || '').split(' ').includes(u)); });
  }));
</script>