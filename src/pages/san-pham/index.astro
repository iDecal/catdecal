---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import { products } from '../../data/products';
---
<Layout title="Mẫu decal thiết kế sẵn | CatDecal.vn" description="Chọn mẫu decal có nội dung thiết kế sẵn; chọn màu sắc, kích thước và yêu cầu báo giá giao hàng toàn quốc." active="products">
<main style="max-width:1200px;margin:0 auto;padding:48px 24px 96px">
  <p style="font-size:13px;font-weight:800;text-transform:uppercase">Danh mục sản phẩm</p>
  <h1 style="font-size:clamp(34px,5vw,50px);letter-spacing:-.03em">Mẫu decal thiết kế sẵn</h1>
  <p style="max-width:720px;line-height:1.8">Chọn mẫu với nội dung cố định, tùy chọn màu và kích thước. Giá và thời gian thực hiện được xác nhận trước khi đặt. Muốn thay chữ hoặc làm logo riêng? <a href="/dich-vu/">Đặt dịch vụ cắt theo yêu cầu</a>.</p>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px;margin-top:34px">
    {products.map((p) => <article style="border-radius:22px;background:white;overflow:hidden;display:flex;flex-direction:column"><Scene scene={p.scene} ink={p.ink} label={p.sample}/><div style="padding:22px;display:flex;flex-direction:column;gap:12px;flex:1"><strong style="font-size:19px">{p.name}</strong><p style="line-height:1.65;margin:0">{p.desc}</p><div style="margin-top:auto"><a href={p.href} style="background:#111;color:#fff;padding:13px 18px;border-radius:999px;text-decoration:none;font-weight:800;display:inline-block">Xem mẫu →</a></div></div></article>)}
  </div>
</main>
</Layout>
