---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import { products, relatedTo } from '../../data/products';
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const p = product.page;
const colors = p.colors;
const sizes = p.sizes.map((label: string, idx: number) => ({ label, idx }));
const color0 = colors[0];
const related = relatedTo(product.slug);
const colorOpts = colors.map((c: any, idx: number) => ({ label: c.name, idx }));
const highlights = p.highlights;
const uses = p.uses;
const fmts = [
  { label: 'Decal đã cắt sẵn', note: 'Giao decal đã cắt và bóc nền, kèm giấy chuyển để bạn tự dán dễ dàng.' },
  { label: 'File thiết kế (vector)', note: 'Nhận file vector (SVG, AI, PDF) để tự cắt bằng máy của bạn. Không kèm decal.' }
];
const formats = fmts.map((f, i) => ({
  ...f,
  style: 'display: flex; gap: 12px; align-items: flex-start; box-sizing: border-box; padding: 12px 14px; border-radius: 12px; cursor: pointer; min-height: 44px; border: 2px solid ' + (i === 0 ? '#111' : '#E5E1D8') + '; background: ' + (i === 0 ? '#FFF9E9' : '#fff'),
  on: i === 0
}));
const previewStyle = 'width: 100%; box-sizing: border-box; min-height: 380px; border-radius: 24px; display: flex; align-items: center; justify-content: center; padding: 32px; overflow: hidden; background: #E9E2D3; color: ' + color0.hex;
const dotStyle = 'width: 24px; height: 24px; border-radius: 50%; flex: none; border: 2px solid #111; background: ' + color0.hex;
const summary = p.name + ' · ' + p.sizes[1] + ' · Màu ' + color0.name.toLowerCase() + ' · ' + fmts[0].label + ' · SL 1';
const clientData = { name: p.name, sizes: p.sizes, colors };
---
<Layout title={p.name + ' | CatDecal.vn'} description={p.desc} active="products">

  <div style="max-width: 1200px; margin: 0 auto; padding: 16px 24px 72px; display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start">

    <!-- Xem trước -->
    <div style="flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
      <div id="preview" style={previewStyle}>
        {p.kind === 'kinh' && (<>
          <svg role="img" aria-label="Minh họa chữ decal dán trên kính cửa hàng" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><rect x="0" y="0" width="40" height="34" fill="#FFC928"></rect><rect x="40" y="0" width="40" height="34" fill="#FFF9E9"></rect><rect x="80" y="0" width="40" height="34" fill="#FFC928"></rect><rect x="120" y="0" width="40" height="34" fill="#FFF9E9"></rect><rect x="160" y="0" width="40" height="34" fill="#FFC928"></rect><rect x="200" y="0" width="40" height="34" fill="#FFF9E9"></rect><rect x="240" y="0" width="40" height="34" fill="#FFC928"></rect><rect x="280" y="0" width="40" height="34" fill="#FFF9E9"></rect><rect x="20" y="46" width="280" height="128" rx="6" fill={p.surface} stroke="#111" stroke-width="3"></rect><path d="M60 46 L112 174 M124 46 L176 174" stroke="#fff" stroke-opacity="0.16" stroke-width="14"></path><text x="160" y="120" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="44" fill="currentColor">{p.sample}</text><rect x="106" y="136" width="108" height="6" rx="3" fill="currentColor" fill-opacity="0.8"></rect></svg>
        </>)}
        {p.kind === 'mo' && (<>
          <svg role="img" aria-label="Minh họa decal mờ dán vách kính văn phòng" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><defs><pattern id="pDots" width="6" height="6" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="1.4" fill="#111" fill-opacity="0.3"></circle></pattern></defs><rect x="14" y="14" width="136" height="152" fill={p.surface} stroke="#111" stroke-width="3"></rect><rect x="170" y="14" width="136" height="152" fill={p.surface} stroke="#111" stroke-width="3"></rect><circle cx="82" cy="50" r="12" fill="#111" fill-opacity="0.3"></circle><rect x="62" y="64" width="40" height="60" rx="16" fill="#111" fill-opacity="0.3"></rect><text x="160" y="46" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="28" fill="currentColor">{p.sample}</text><rect x="14" y="96" width="292" height="40" fill="currentColor" fill-opacity="0.85"></rect><rect x="14" y="96" width="292" height="40" fill="url(#pDots)"></rect></svg>
        </>)}
        {p.kind === 'xe' && (<>
          <svg role="img" aria-label="Minh họa chữ decal dán trên thân xe" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><rect y="150" width="320" height="30" fill="#D3C9B3"></rect><path d="M78 92 L104 58 L206 58 L240 92 Z" fill={p.surface} stroke="#111" stroke-width="3" stroke-linejoin="round"></path><path d="M92 90 L110 64 L152 64 L152 90 Z" fill="#D9E6E4"></path><path d="M160 64 L202 64 L226 90 L160 90 Z" fill="#D9E6E4"></path><rect x="24" y="90" width="282" height="52" rx="14" fill={p.surface} stroke="#111" stroke-width="3"></rect><text x="165" y="125" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="26" fill="currentColor">{p.sample}</text><circle cx="90" cy="144" r="20" fill="#111"></circle><circle cx="90" cy="144" r="8" fill="#9A9A94"></circle><circle cx="240" cy="144" r="20" fill="#111"></circle><circle cx="240" cy="144" r="8" fill="#9A9A94"></circle></svg>
        </>)}
        {p.kind === 'quang' && (<>
          <svg role="img" aria-label="Minh họa decal phản quang trên thùng xe lúc trời tối" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><defs><pattern id="pStripe" width="20" height="20" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="10" height="20" fill="currentColor"></rect></pattern></defs><rect width="320" height="180" rx="12" fill="#1C1F26"></rect><circle cx="40" cy="148" r="44" fill="currentColor" fill-opacity="0.22"></circle><circle cx="280" cy="148" r="44" fill="currentColor" fill-opacity="0.22"></circle><rect x="70" y="22" width="180" height="118" rx="6" fill={p.surface} stroke="#9A9A94" stroke-width="3"></rect><line x1="160" y1="22" x2="160" y2="140" stroke="#9A9A94" stroke-width="2"></line><text x="160" y="80" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="36" fill="currentColor">{p.sample}</text><rect x="70" y="102" width="180" height="20" fill="url(#pStripe)"></rect><rect x="64" y="140" width="192" height="10" rx="3" fill="#111"></rect><rect x="90" y="150" width="28" height="18" rx="3" fill="#111"></rect><rect x="202" y="150" width="28" height="18" rx="3" fill="#111"></rect></svg>
        </>)}
        {p.kind === 'tuong' && (<>
          <svg role="img" aria-label="Minh họa chữ decal dán trên tường phòng khách" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><rect x="0" y="0" width="320" height="150" fill={p.surface}></rect><rect y="150" width="320" height="30" fill="#C9B8A3"></rect><text x="160" y="76" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="800" font-size="44" fill="currentColor">{p.sample}</text><rect x="80" y="94" width="160" height="34" rx="12" fill="#6F8E8B"></rect><rect x="70" y="118" width="180" height="32" rx="12" fill="#5E7C80"></rect><rect x="84" y="150" width="8" height="10" fill="#111"></rect><rect x="228" y="150" width="8" height="10" fill="#111"></rect><rect x="270" y="124" width="26" height="26" rx="4" fill="#111"></rect><ellipse cx="283" cy="108" rx="9" ry="20" fill="#3F7A4F"></ellipse><ellipse cx="270" cy="114" rx="7" ry="15" fill="#4D9460" transform="rotate(-25 270 114)"></ellipse><ellipse cx="296" cy="114" rx="7" ry="15" fill="#4D9460" transform="rotate(25 296 114)"></ellipse></svg>
        </>)}
        {p.kind === 'ten' && (<>
          <svg role="img" aria-label="Minh họa tên decal dán trên bình nước và laptop" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><rect x="104" y="12" width="56" height="16" rx="4" fill="#111"></rect><rect x="96" y="28" width="72" height="138" rx="16" fill={p.surface} stroke="#111" stroke-width="3"></rect><text x="132" y="104" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="24" fill="currentColor">{p.sample}</text><rect x="196" y="58" width="108" height="72" rx="6" fill={p.surface} stroke="#111" stroke-width="3"></rect><rect x="186" y="130" width="128" height="9" rx="4" fill="#111"></rect><text x="250" y="108" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="36" fill="currentColor">M</text></svg>
        </>)}
      </div>
      <div style="font-size: 13px; line-height: 1.6">Ảnh xem trước minh họa màu decal đã chọn trên bề mặt. Màu thực tế có thể lệch nhẹ tùy màn hình.</div>
    </div>

    <!-- Thông tin -->
    <div style="flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
      <div style="display: flex; flex-direction: column; gap: 10px">
        <div style="font-weight: 700; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase">{p.tag}</div>
        <h1 style="margin: 0; font-size: 34px; line-height: 1.08; letter-spacing: -0.03em; font-weight: 900">{p.name}</h1>
        <div style="font-weight: 800; font-size: 19px">Giá: liên hệ xác nhận</div>
        <p style="margin: 0; font-size: 15px; line-height: 1.6">{p.desc}</p>
      </div>

      <div style="background: #fff; border-radius: 16px; overflow: hidden">
        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; padding: 14px 18px">
          <label for="p-size" style="font-weight: 800; font-size: 14px">Kích thước</label>
          <select id="p-size" style="font: inherit; font-size: 14px; padding: 10px 12px; border: 2px solid #111; border-radius: 12px; background: #fff; min-height: 44px; min-width: 200px; box-sizing: border-box">
            {sizes.map((s) => (<>
              <option value={s.idx} selected={s.idx === 1}>{s.label}</option>
            </>))}
          </select>
        </div>

        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; padding: 14px 18px; border-top: 1px solid #E5E1D8">
          <label for="p-color" style="font-weight: 800; font-size: 14px">Màu decal</label>
          <div style="display: flex; align-items: center; gap: 10px">
            <span id="p-dot" aria-hidden="true" style={dotStyle}></span>
            <select id="p-color" style="font: inherit; font-size: 14px; padding: 10px 12px; border: 2px solid #111; border-radius: 12px; background: #fff; min-height: 44px; min-width: 164px; box-sizing: border-box">
              {colorOpts.map((c) => (<>
                <option value={c.idx}>{c.label}</option>
              </>))}
            </select>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 10px; padding: 14px 18px; border-top: 1px solid #E5E1D8">
          <div style="font-weight: 800; font-size: 14px">Bạn nhận được</div>
          {formats.map((f) => (<>
            <label class="fmt" style={f.style}>
              <input type="radio" name="p-format" checked={f.on} value={f.label} style="width: 20px; height: 20px; margin: 2px 0 0; accent-color: #111; flex: none">
              <span style="display: flex; flex-direction: column; gap: 2px">
                <span style="font-weight: 700; font-size: 14px">{f.label}</span>
                <span style="font-size: 13px; line-height: 1.5">{f.note}</span>
              </span>
            </label>
          </>))}
        </div>

        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; padding: 14px 18px; border-top: 1px solid #E5E1D8">
          <label for="p-qty" style="font-weight: 800; font-size: 14px">Số lượng</label>
          <input id="p-qty" type="number" min="1" value="1" style="font: inherit; font-size: 14px; padding: 10px 12px; border: 2px solid #111; border-radius: 12px; background: #fff; min-height: 44px; width: 110px; box-sizing: border-box">
        </div>
      </div>

      <div style="font-size: 14px; line-height: 1.6"><b>Bạn đã chọn:</b> <span id="p-summary">{summary}</span></div>

      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px">
        <a href="/dich-vu/" style="background: #FFC928; color: #111; text-decoration: none; font-weight: 800; font-size: 15px; padding: 16px 28px; border-radius: 999px">Gửi yêu cầu đặt hàng</a>
        <a href="/" style="font-weight: 700; font-size: 14px; padding: 12px 0">← Xem sản phẩm khác</a>
      </div>
    </div>
  </div>

  <!-- Chi tiết -->
  <div style="background: #fff; padding: 48px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 40px">
      <div style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
        <h2 style="margin: 0; font-size: 23px; letter-spacing: -0.02em; font-weight: 900">Điểm nổi bật</h2>
        {highlights.map((h) => (<>
          <div style="display: flex; gap: 12px; align-items: flex-start; font-size: 15px; line-height: 1.6">
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22" style="flex: none; margin-top: 2px"><circle cx="11" cy="11" r="11" fill="#111"></circle><path d="M6 11.5 L9.5 15 L16 8" stroke="#FFF9E9" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>{h}</span>
          </div>
        </>))}
      </div>
      <div style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
        <h2 style="margin: 0; font-size: 23px; letter-spacing: -0.02em; font-weight: 900">Phù hợp để dán</h2>
        <div style="display: flex; flex-wrap: wrap; gap: 10px">
          {uses.map((u) => (<>
            <span style="border: 2px solid #111; border-radius: 999px; padding: 9px 16px; font-size: 13px; font-weight: 600">{u}</span>
          </>))}
        </div>
        <div style="font-size: 14px; line-height: 1.7">Cần đổi nội dung chữ, đổi font hoặc kích thước riêng? Gửi yêu cầu, bên mình chỉnh mẫu và báo giá trước khi cắt. Phí chỉnh sửa: [PHÍ].</div>
      </div>
    </div>
  </div>

  <!-- Sản phẩm liên quan -->
  <div style="padding: 56px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 24px">
      <h2 style="margin: 0; font-size: 30px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">Sản phẩm liên quan</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 20px">
        {related.map((r) => (<>
          <a href={r.href} style="flex: 1 1 280px; min-width: 0; box-sizing: border-box; text-decoration: none; color: #111; background: #fff; border-radius: 20px; overflow: hidden; display: flex; flex-direction: column">
            <div style="width: 100%">
              <Scene scene={r.scene} ink={r.ink} label={r.sample} />
            </div>
            <div style="padding: 16px 20px 20px; display: flex; flex-direction: column; gap: 6px">
              <div style="font-weight: 800; font-size: 16px">{r.name}</div>
              <div style="font-weight: 700; font-size: 13px">Xem chi tiết →</div>
            </div>
          </a>
        </>))}
      </div>
    </div>
  </div>

</Layout>
<script define:vars={{ clientData }}>
  const { name, sizes, colors } = clientData;
  const $ = (id) => document.getElementById(id);
  function update() {
    const col = colors[Number($('p-color').value)];
    $('preview').style.color = col.hex;
    $('p-dot').style.background = col.hex;
    const fm = document.querySelector('input[name=p-format]:checked');
    document.querySelectorAll('.fmt').forEach((l) => {
      const on = l.querySelector('input').checked;
      l.style.borderColor = on ? '#111' : '#E5E1D8';
      l.style.background = on ? '#FFF9E9' : '#fff';
    });
    const q = Math.max(1, parseInt($('p-qty').value, 10) || 1);
    $('p-summary').textContent = name + ' · ' + sizes[Number($('p-size').value)] + ' · Màu ' + col.name.toLowerCase() + ' · ' + fm.value + ' · SL ' + q;
  }
  ['p-size', 'p-color', 'p-qty'].forEach((id) => $(id).addEventListener('input', update));
  document.querySelectorAll('input[name=p-format]').forEach((r) => r.addEventListener('change', update));
</script>