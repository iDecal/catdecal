---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import { products } from '../data/products';
const tiles = [
  { id: 'kinh', label: 'Kính & cửa', blurb: 'Tên quán, giờ mở cửa, vách văn phòng', scene: 'kinh', ink: '#FFFFFF', sample: 'MỞ CỬA' },
  { id: 'xe', label: 'Xe', blurb: 'Tem chữ, số điện thoại, decal phản quang', scene: 'xe', ink: '#FFD60A', sample: 'GARAGE' },
  { id: 'tuong', label: 'Tường & nội thất', blurb: 'Câu chữ trang trí, tên phòng', scene: 'tuong', ink: '#111111', sample: 'Welcome' },
  { id: 'qua', label: 'Quà tặng', blurb: 'Tên cá nhân trên bình nước, laptop', scene: 'ten', ink: '#FFD60A', sample: 'Minh' }
];
const tabs = [
  { id: 'all', label: 'Tất cả' }, { id: 'kinh', label: 'Kính & cửa' }, { id: 'xe', label: 'Xe' },
  { id: 'tuong', label: 'Tường & nội thất' }, { id: 'qua', label: 'Quà tặng' }
].map((x) => ({ ...x, cls: x.id === 'all' ? 'chip on' : 'chip' }));
const list = products;
const services = [
  { no: '01', title: 'Cắt theo file có sẵn', desc: 'Gửi file vector (AI, SVG, PDF, CDR). Cắt đúng kích thước, bóc nền sẵn.' },
  { no: '02', title: 'Thiết kế chữ và logo', desc: 'Chưa có file? Mô tả ý tưởng, bên mình dựng mẫu để bạn duyệt.' },
  { no: '03', title: 'Cắt số lượng lớn', desc: 'Tem, nhãn, chữ lặp lại với số lượng nhiều, giá tốt theo mốc.' },
  { no: '04', title: 'Hướng dẫn hoặc nhận dán', desc: 'Kèm lớp định hình để tự dán dễ, hoặc đặt thợ dán tại công trình.' }
];
const brands = ['3M', 'Avery Dennison', 'ORACAL', '[THƯƠNG HIỆU KHÁC]'];
const materials = ['Decal màu trơn', 'Decal xi (ánh kim)', 'Decal phản quang', 'Decal mờ dán kính', 'Decal trong', 'Decal vân gỗ, carbon'];
const steps = [
  { no: '1', title: 'Gửi yêu cầu', desc: 'Cho biết nội dung, kích thước, chất liệu, số lượng.' },
  { no: '2', title: 'Nhận báo giá và mẫu', desc: 'Duyệt bản thiết kế và giá trước khi cắt.' },
  { no: '3', title: 'Cắt và kiểm tra', desc: 'Cắt bằng máy, bóc nền, kiểm tra từng nét.' },
  { no: '4', title: 'Giao hàng', desc: 'Đóng gói phẳng kèm lớp định hình, gửi toàn quốc.' }
];
---
<Layout title="Dịch vụ cắt decal theo yêu cầu tại TP.HCM | CatDecal.vn" description="Chuyên cắt decal theo yêu cầu tại TP.HCM, giao hàng toàn quốc: chữ dán kính, tem xe, chữ dán tường, tên cá nhân. Gửi file nhận báo giá." active="home">

  <!-- Hero -->
  <div id="top" style="max-width: 1200px; margin: 0 auto; padding: 24px 24px 64px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
    <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
      <div style="align-self: flex-start; background: #111; color: #FFD60A; font-weight: 700; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; padding: 8px 14px; border-radius: 999px">Decal cắt chữ · Decal cắt hình</div>
      <h1 style="margin: 0; font-size: 52px; line-height: 1.02; letter-spacing: -0.04em; font-weight: 900">Cắt chuẩn từng nét.<br><span style="background: linear-gradient(transparent 62%, #FFD60A 62%)">Dán là đẹp.</span></h1>
      <p style="margin: 0; font-size: 16px; line-height: 1.7; max-width: 520px">Chuyên cắt decal theo yêu cầu tại TP.HCM, giao hàng toàn quốc: chữ, logo, hoa văn, tem xe, chữ dán kính. Gửi file hoặc ý tưởng, bên mình cắt và gửi đến tận nơi.</p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px">
        <a href="#san-pham" style="background: #FFD60A; color: #111; text-decoration: none; font-weight: 800; font-size: 15px; padding: 16px 28px; border-radius: 999px">Xem sản phẩm</a>
        <a href="/dich-vu/" style="border: 2px solid #111; color: #111; text-decoration: none; font-weight: 700; font-size: 15px; padding: 14px 26px; border-radius: 999px">Gửi file đặt cắt</a>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 13px; font-weight: 700">
        <span style="display: flex; align-items: center; gap: 8px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="#111"></circle><path d="M6 11.5 L9.5 15 L16 8" stroke="#FFD60A" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>Máy cắt của Nhật</span>
        <span style="display: flex; align-items: center; gap: 8px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="#111"></circle><path d="M6 11.5 L9.5 15 L16 8" stroke="#FFD60A" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>Có lớp định hình dễ dán</span>
        <span style="display: flex; align-items: center; gap: 8px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="#111"></circle><path d="M6 11.5 L9.5 15 L16 8" stroke="#FFD60A" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>Video hướng dẫn</span>
      </div>
    </div>
    <div style="flex: 1 1 400px; min-width: 0">
      <div style="background: #FFD60A; border-radius: 32px; padding: 14px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px">
        <div style="grid-column: 1 / span 2; border-radius: 20px; overflow: hidden">
          <Scene scene="kinh" ink="#FFFFFF" label="MỞ CỬA" />
        </div>
        <div style="border-radius: 20px; overflow: hidden">
          <Scene scene="xe" ink="#FFD60A" label="GARAGE" />
        </div>
        <div style="border-radius: 20px; overflow: hidden">
          <Scene scene="ten" ink="#FFD60A" label="Minh" />
        </div>
      </div>
    </div>
  </div>

  <!-- Thương hiệu -->
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px 56px">
    <div style="border-top: 2px solid #111; border-bottom: 2px solid #111; padding: 22px 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px">
      <div style="font-weight: 700; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase">Vật liệu từ các thương hiệu</div>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px 36px">
        {brands.map((b) => (<>
          <span style="font-weight: 900; font-size: 22px; letter-spacing: -0.02em">{b}</span>
        </>))}
      </div>
      <a href="/vat-lieu/" style="font-weight: 700; font-size: 14px; padding: 12px 0">Xem thông tin các hãng →</a>
    </div>
  </div>

  <!-- Chọn theo nơi dán -->
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px 64px; display: flex; flex-direction: column; gap: 28px">
    <div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px">
      <div style="display: flex; flex-direction: column; gap: 10px">
        <div style="font-weight: 700; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase">Chọn nhanh</div>
        <h2 style="margin: 0; font-size: 34px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">Bạn định dán ở đâu?</h2>
      </div>
      <a href="/vat-lieu/" style="font-weight: 700; font-size: 14px; padding: 12px 0">Không chắc chọn loại nào? Xem vật liệu →</a>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 20px">
      {tiles.map((t) => (<>
        <a href="#san-pham" data-pick={t.id} style="flex: 1 1 230px; min-width: 0; box-sizing: border-box; text-decoration: none; color: #111; background: #fff; border-radius: 24px; overflow: hidden; display: flex; flex-direction: column">
          <div style="width: 100%">
            <Scene scene={t.scene} ink={t.ink} label={t.sample} />
          </div>
          <div style="padding: 16px 20px 20px; display: flex; flex-direction: column; gap: 4px">
            <div style="font-weight: 800; font-size: 17px">{t.label}</div>
            <div style="font-size: 13px; line-height: 1.5">{t.blurb}</div>
          </div>
        </a>
      </>))}
    </div>
  </div>

  <!-- Sản phẩm -->
  <div id="san-pham" style="background: #fff; padding: 56px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 28px">
      <div style="display: flex; flex-direction: column; gap: 10px">
        <div style="font-weight: 700; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase">Sản phẩm</div>
        <h2 style="margin: 0; font-size: 34px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">Decal cắt chữ làm sẵn</h2>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 10px">
        {tabs.map((tab) => (<>
          <button type="button" data-chip data-cat={tab.id} class={tab.cls}>{tab.label}</button>
        </>))}
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 20px">
        {list.map((p) => (<>
          <div data-card data-cat={p.cat} style="flex: 1 1 320px; max-width: 100%; min-width: 0; box-sizing: border-box; background: #F6F4EF; border-radius: 24px; overflow: hidden; display: flex; flex-direction: column">
            <div style="width: 100%">
              <Scene scene={p.scene} ink={p.ink} label={p.sample} />
            </div>
            <div style="padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 8px">
              <div style="font-weight: 800; font-size: 17px">{p.name}</div>
              <div style="font-size: 14px; line-height: 1.55">{p.desc}</div>
              <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 8px">
                <span style="font-weight: 800; font-size: 15px">Từ [GIÁ]</span>
                <a href={p.href} style="background: #111; color: #F6F4EF; text-decoration: none; font-weight: 700; font-size: 13px; padding: 12px 18px; border-radius: 999px">Xem chi tiết</a>
              </div>
            </div>
          </div>
        </>))}
      </div>
    </div>
  </div>

  <!-- Dịch vụ -->
  <div id="dich-vu" style="background: #111; color: #F6F4EF; padding: 64px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
      <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
        <div style="display: flex; flex-direction: column; gap: 12px">
          <div style="font-weight: 700; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: #FFD60A">Dịch vụ</div>
          <h2 style="margin: 0; font-size: 34px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">Cắt decal theo yêu cầu</h2>
          <p style="margin: 0; font-size: 15px; line-height: 1.7">Bạn có sẵn file hoặc chỉ có ý tưởng, đều nhận được. Cắt bằng máy của Nhật, từ một chiếc đến số lượng lớn.</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px">
          {services.map((s) => (<>
            <div style="box-sizing: border-box; border: 1px solid #3A3A3A; border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 6px">
              <div style="font-weight: 900; font-size: 22px; color: #FFD60A">{s.no}</div>
              <div style="font-weight: 800; font-size: 15px">{s.title}</div>
              <div style="font-size: 13px; line-height: 1.55">{s.desc}</div>
            </div>
          </>))}
        </div>
        <div style="display: flex">
          <a href="/dich-vu/" style="background: #FFD60A; color: #111; text-decoration: none; font-weight: 800; font-size: 15px; padding: 16px 28px; border-radius: 999px">Gửi file đặt cắt</a>
        </div>
      </div>
      <div style="flex: 1 1 380px; min-width: 0">
        <div style="border-radius: 28px; overflow: hidden; border: 6px solid #FFD60A">
          <Scene scene="may" ink="#FFD60A" label="Aa" />
        </div>
      </div>
    </div>
  </div>

  <!-- Vật liệu -->
  <div id="vat-lieu" style="padding: 64px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
      <div style="flex: 1 1 380px; min-width: 0">
        <div style="border-radius: 28px; overflow: hidden">
          <Scene scene="mau" />
        </div>
      </div>
      <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
        <div style="font-weight: 700; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase">Vật liệu</div>
        <h2 style="margin: 0; font-size: 34px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">Màu trơn, xi, phản quang, mờ…</h2>
        <p style="margin: 0; font-size: 15px; line-height: 1.7">Mỗi loại decal hợp với một nơi dán khác nhau. Xem đặc điểm, nơi dùng và lưu ý trước khi đặt cắt.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 10px">
          {materials.map((m) => (<>
            <a href="/vat-lieu/" style="border: 2px solid #111; color: #111; text-decoration: none; border-radius: 999px; padding: 9px 16px; font-size: 13px; font-weight: 700">{m}</a>
          </>))}
        </div>
        <div style="display: flex">
          <a href="/vat-lieu/" style="font-weight: 800; font-size: 14px; padding: 12px 0">Xem tất cả vật liệu →</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Quy trình -->
  <div id="quy-trinh" style="background: #fff; padding: 56px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 32px">
      <h2 style="margin: 0; font-size: 34px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">Đặt cắt decal trong 4 bước</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 24px">
        {steps.map((st) => (<>
          <div style="flex: 1 1 230px; min-width: 0; display: flex; flex-direction: column; gap: 10px; border-top: 4px solid #111; padding-top: 16px">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: #FFD60A; font-weight: 900; font-size: 17px; display: flex; align-items: center; justify-content: center">{st.no}</div>
            <div style="font-weight: 800; font-size: 17px">{st.title}</div>
            <div style="font-size: 14px; line-height: 1.6">{st.desc}</div>
          </div>
        </>))}
      </div>
    </div>
  </div>

  <!-- Blog -->
  <div style="padding: 64px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 28px">
      <div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px">
        <div style="display: flex; flex-direction: column; gap: 10px">
          <div style="font-weight: 700; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase">Blog</div>
          <h2 style="margin: 0; font-size: 34px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">Kinh nghiệm dùng decal</h2>
        </div>
        <a href="/blog/" style="font-weight: 700; font-size: 14px; padding: 12px 0">Xem tất cả bài viết →</a>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 20px">
        <a href="/blog/dan-decal-kinh/" style="flex: 1 1 360px; min-width: 0; box-sizing: border-box; text-decoration: none; color: #111; background: #fff; border-radius: 24px; overflow: hidden; display: flex; flex-direction: column">
          <div style="width: 100%">
            <Scene scene="kinh" ink="#FFFFFF" label="MỞ CỬA" />
          </div>
          <div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 8px">
            <div style="font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase">Hướng dẫn</div>
            <div style="font-weight: 900; font-size: 20px; line-height: 1.25; letter-spacing: -0.02em">Cách dán decal chữ lên kính cửa hàng không bị bọt khí</div>
            <div style="font-weight: 800; font-size: 14px">Đọc bài →</div>
          </div>
        </a>
        <a href="/blog/chon-chat-lieu/" style="flex: 1 1 360px; min-width: 0; box-sizing: border-box; text-decoration: none; color: #111; background: #fff; border-radius: 24px; overflow: hidden; display: flex; flex-direction: column">
          <div style="width: 100%">
            <Scene scene="mau" />
          </div>
          <div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 8px">
            <div style="font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase">Chất liệu</div>
            <div style="font-weight: 900; font-size: 20px; line-height: 1.25; letter-spacing: -0.02em">Chọn chất liệu decal cắt chữ: trơn, ánh kim, phản quang hay mờ?</div>
            <div style="font-weight: 800; font-size: 14px">Đọc bài →</div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- Liên hệ -->
  <div id="lien-he" style="background: #FFD60A; padding: 56px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between">
      <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 14px">
        <h2 style="margin: 0; font-size: 38px; line-height: 1.08; letter-spacing: -0.035em; font-weight: 900">Có file rồi? Gửi ngay, nhận báo giá nhanh.</h2>
        <p style="margin: 0; font-size: 15px; line-height: 1.7; max-width: 520px">Cho bên mình biết kích thước, chất liệu và số lượng. Bạn sẽ được báo giá và xem bản thiết kế trước khi cắt.</p>
        <div style="font-weight: 700; font-size: 15px; line-height: 1.8">Zalo / Điện thoại: <a href="tel:0866077040">0866 077 040</a><br>Email: <a href="mailto:hi@idecal.vn">hi@idecal.vn</a><br>Khu vực hoạt động: TP. Hồ Chí Minh – Giao hàng toàn quốc</div>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 12px">
        <a href="/dich-vu/" style="background: #111; color: #F6F4EF; text-decoration: none; font-weight: 800; font-size: 16px; padding: 18px 32px; border-radius: 999px">Gửi file đặt cắt</a>
        <a href="/dich-vu/" style="border: 2px solid #111; color: #111; text-decoration: none; font-weight: 700; font-size: 16px; padding: 16px 30px; border-radius: 999px">Gửi yêu cầu tư vấn</a>
      </div>
    </div>
  </div>

  <!-- Chân trang -->
</Layout>
<script>
  const chips = Array.from(document.querySelectorAll('[data-chip]'));
  const cards = Array.from(document.querySelectorAll('[data-card]'));
  function setCat(c) {
    chips.forEach((b) => {
      const on = b.dataset.cat === c;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });
    cards.forEach((x) => { x.hidden = !(c === 'all' || x.dataset.cat === c); });
  }
  chips.forEach((b) => b.addEventListener('click', () => setCat(b.dataset.cat)));
  document.querySelectorAll('[data-pick]').forEach((a) => a.addEventListener('click', () => setCat(a.dataset.pick)));
</script>