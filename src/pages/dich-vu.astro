---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import services from '../data/services.json';

---
<Layout title="Cắt decal theo yêu cầu: gửi file nhận báo giá | CatDecal.vn" description="Gửi file thiết kế, chọn chất liệu, kích thước và số lượng. Nhận báo giá và mẫu duyệt trước khi cắt." active="service">

  <!-- Mở đầu -->
  <div style="max-width: 1200px; margin: 0 auto; padding: 32px 24px 40px; display: flex; flex-direction: column; gap: 16px; max-width: 1200px">
    <div style="font-weight: 700; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase">Dịch vụ</div>
    <h1 style="margin: 0; font-size: 40px; line-height: 1.08; letter-spacing: -0.035em; font-weight: 900; max-width: 760px">Cắt decal theo yêu cầu: gửi file, nhận decal đã cắt.</h1>
    <p style="margin: 0; font-size: 16px; line-height: 1.7; max-width: 640px">Chọn file thiết kế của bạn, cho biết chất liệu, kích thước và số lượng. Bên mình báo giá, gửi mẫu duyệt rồi mới cắt. Mỗi đơn đều có lớp định hình để bạn dán dễ.</p>
  </div>

  <section id="danh-sach" style="max-width:1200px;margin:0 auto;padding:0 24px 44px">
    <h2 style="margin:0 0 18px;font-size:30px">Chọn loại dịch vụ</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px">
      {services.map((service) => <a href={'/dich-vu/'+service.slug+'/'} style="background:#fff;padding:24px;border-radius:18px;color:#111;text-decoration:none;display:flex;flex-direction:column;gap:12px"><strong style="font-size:18px">{service.name}</strong><span style="line-height:1.6;font-size:14px">{service.short}</span><span style="margin-top:auto;font-weight:800">Chi tiết dịch vụ →</span></a>)}
    </div>
  </section>

  <!-- Form -->
  <div id="yeu-cau" style="max-width: 1200px; margin: 0 auto; padding: 0 24px 56px; display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start">

    <div style="flex: 2 1 480px; min-width: 0; box-sizing: border-box; background: #fff; border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 20px">

      <div style="display: flex; flex-direction: column; gap: 10px">
        <div style="font-weight: 800; font-size: 17px">1. Chọn file thiết kế</div>
        <label for="f-file" id="drop" style="position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; box-sizing: border-box; padding: 28px 20px; border-radius: 20px; cursor: pointer; border: 3px dashed #111; min-height: 160px; color: #111; background: #F6F4EF">
          <svg aria-hidden="true" width="36" height="36" viewBox="0 0 36 36"><path d="M18 24 V8 M11 14 L18 7 L25 14" stroke="#111" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6 22 V28 Q6 30 8 30 H28 Q30 30 30 28 V22" stroke="#111" stroke-width="2.6" fill="none" stroke-linecap="round"></path></svg>
          <span style="font-weight: 800; font-size: 15px">Bấm để chọn file hoặc kéo thả vào đây</span>
          <span style="font-size: 13px; line-height: 1.5">AI, SVG, PDF, CDR, EPS, DXF, PNG, JPG · tối đa 5 file, mỗi file 20 MB</span>
          <input id="f-file" type="file" multiple accept=".ai,.svg,.pdf,.cdr,.eps,.dxf,.png,.jpg,.jpeg" style="position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden">
        </label>

        <div id="f-errors" hidden role="alert" style="background: #FFF1C2; border-radius: 12px; padding: 12px 16px; display: flex; flex-direction: column; gap: 4px; font-size: 13px; line-height: 1.5"></div>
        <div id="f-list" style="display: flex; flex-direction: column; gap: 8px"></div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 14px">
        <div style="font-weight: 800; font-size: 17px">2. Thông tin đơn cắt</div>
        <div style="display: flex; flex-wrap: wrap; gap: 14px">
          <div style="flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 6px">
            <label for="s-ten" style="font-weight: 700; font-size: 13px">Họ tên</label>
            <input id="s-ten" type="text" style="font: inherit; font-size: 14px; padding: 12px 14px; border: 2px solid #111; border-radius: 12px; background: #fff; min-height: 48px; box-sizing: border-box; width: 100%">
          </div>
          <div style="flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 6px">
            <label for="s-sdt" style="font-weight: 700; font-size: 13px">Số điện thoại / Zalo</label>
            <input id="s-sdt" type="text" style="font: inherit; font-size: 14px; padding: 12px 14px; border: 2px solid #111; border-radius: 12px; background: #fff; min-height: 48px; box-sizing: border-box; width: 100%">
          </div>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 14px">
          <div style="flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 6px">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 4px 12px">
              <label for="s-cl" style="font-weight: 700; font-size: 13px">Chất liệu</label>
              <a href="/vat-lieu/" style="font-weight: 700; font-size: 12px; padding: 6px 0">Xem các loại vật liệu →</a>
            </div>
            <select id="s-cl" style="font: inherit; font-size: 14px; padding: 12px 14px; border: 2px solid #111; border-radius: 12px; background: #fff; min-height: 48px; box-sizing: border-box; width: 100%">
              <option>Decal màu trơn</option>
              <option>Decal ánh kim</option>
              <option>Decal phản quang</option>
              <option>Decal mờ dán kính</option>
              <option>Chưa rõ, cần tư vấn</option>
            </select>
          </div>
          <div style="flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 6px">
            <label for="s-mau" style="font-weight: 700; font-size: 13px">Màu decal</label>
            <input id="s-mau" type="text" style="font: inherit; font-size: 14px; padding: 12px 14px; border: 2px solid #111; border-radius: 12px; background: #fff; min-height: 48px; box-sizing: border-box; width: 100%">
          </div>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 14px">
          <div style="flex: 1 1 140px; min-width: 0; display: flex; flex-direction: column; gap: 6px">
            <label for="s-rong" style="font-weight: 700; font-size: 13px">Rộng (cm)</label>
            <input id="s-rong" type="text" inputmode="decimal" style="font: inherit; font-size: 14px; padding: 12px 14px; border: 2px solid #111; border-radius: 12px; background: #fff; min-height: 48px; box-sizing: border-box; width: 100%">
          </div>
          <div style="flex: 1 1 140px; min-width: 0; display: flex; flex-direction: column; gap: 6px">
            <label for="s-cao" style="font-weight: 700; font-size: 13px">Cao (cm)</label>
            <input id="s-cao" type="text" inputmode="decimal" style="font: inherit; font-size: 14px; padding: 12px 14px; border: 2px solid #111; border-radius: 12px; background: #fff; min-height: 48px; box-sizing: border-box; width: 100%">
          </div>
          <div style="flex: 1 1 140px; min-width: 0; display: flex; flex-direction: column; gap: 6px">
            <label for="s-sl" style="font-weight: 700; font-size: 13px">Số lượng</label>
            <input id="s-sl" type="text" inputmode="numeric" value="1" style="font: inherit; font-size: 14px; padding: 12px 14px; border: 2px solid #111; border-radius: 12px; background: #fff; min-height: 48px; box-sizing: border-box; width: 100%">
          </div>
        </div>
        <label for="s-lop" style="display: flex; align-items: center; gap: 12px; font-size: 14px; font-weight: 600; min-height: 44px">
          <input id="s-lop" type="checkbox" checked style="width: 22px; height: 22px; accent-color: #111">
          Kèm lớp định hình (giấy chuyển) để dễ dán
        </label>
        <div style="display: flex; flex-direction: column; gap: 6px">
          <label for="s-note" style="font-weight: 700; font-size: 13px">Ghi chú (nơi dán, yêu cầu riêng)</label>
          <textarea id="s-note" rows="3" style="font: inherit; font-size: 14px; padding: 12px 14px; border: 2px solid #111; border-radius: 12px; background: #fff; box-sizing: border-box; width: 100%; resize: vertical"></textarea>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 12px">
        <div style="font-weight: 800; font-size: 17px">3. Gửi yêu cầu</div>
        <div style="font-size: 13px; line-height: 1.6">Gửi trực tiếp kèm file thiết kế khi đã cấu hình Cloudflare R2. Bạn vẫn có thể gửi qua email hoặc sao chép nội dung cho Zalo; hai cách này cần đính kèm file thủ công.</div>
        <label style="font-size:12px;display:none" aria-hidden="true">Để trống trường này<input id="s-website" tabindex="-1" autocomplete="off" /></label>
        <div style="display: flex; flex-wrap: wrap; gap: 12px">
          <button type="button" id="btn-upload" style="font: inherit; font-weight: 800; font-size: 15px; min-height: 48px; padding: 0 28px; border-radius: 999px; border: 0; background: #111; color: white; cursor: pointer">Gửi báo giá kèm file</button>
          <button type="button" id="btn-mail" style="font: inherit; font-weight: 800; font-size: 15px; min-height: 48px; padding: 0 28px; border-radius: 999px; border: 0; background: #FFD60A; color: #111; cursor: pointer">Gửi yêu cầu qua email</button>
          <button type="button" id="btn-copy" style="font: inherit; font-weight: 700; font-size: 15px; min-height: 48px; padding: 0 24px; border-radius: 999px; border: 2px solid #111; background: transparent; color: #111; cursor: pointer">Sao chép nội dung gửi Zalo</button>
        </div>
        <div id="f-status" hidden role="status" style="background: #F6F4EF; border-radius: 12px; padding: 12px 16px; font-size: 13px; line-height: 1.6; font-weight: 600"></div>
      </div>
    </div>

    <!-- Bên phải -->
    <div style="flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
      <div style="background: #111; color: #F6F4EF; border-radius: 24px; padding: 24px; display: flex; flex-direction: column; gap: 12px">
        <div style="font-weight: 800; font-size: 17px; color: #FFD60A">File nên chuẩn bị</div>
        <div style="font-size: 14px; line-height: 1.7">Tốt nhất là file vector (AI, SVG, PDF, CDR, EPS, DXF) với chữ đã chuyển thành đường (outline). Ảnh PNG/JPG vẫn nhận, bên mình sẽ dựng lại nét cắt và báo phí nếu cần: [PHÍ DỰNG FILE].</div>
      </div>
      <div style="background: #fff; border-radius: 24px; padding: 24px; display: flex; flex-direction: column; gap: 12px">
        <div style="font-weight: 800; font-size: 17px">Bảng giá tham khảo</div>
        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 14px">
          <div style="display: flex; justify-content: space-between; gap: 12px; padding-bottom: 8px; border-bottom: 1px solid #E5E1D8"><span>Decal màu trơn</span><b>[GIÁ]/m²</b></div>
          <div style="display: flex; justify-content: space-between; gap: 12px; padding-bottom: 8px; border-bottom: 1px solid #E5E1D8"><span>Decal ánh kim</span><b>[GIÁ]/m²</b></div>
          <div style="display: flex; justify-content: space-between; gap: 12px; padding-bottom: 8px; border-bottom: 1px solid #E5E1D8"><span>Decal phản quang</span><b>[GIÁ]/m²</b></div>
          <div style="display: flex; justify-content: space-between; gap: 12px"><span>Decal mờ dán kính</span><b>[GIÁ]/m²</b></div>
        </div>
        <div style="font-size: 12px; line-height: 1.6">Giá cuối cùng phụ thuộc độ phức tạp của nét cắt và số lượng. Bên mình báo giá chính xác sau khi xem file.</div>
      </div>
    </div>
  </div>

  <!-- Quy trình -->
  <div style="background: #fff; padding: 52px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 32px">
      <h2 style="margin: 0; font-size: 30px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">Sau khi bạn gửi file</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 24px">
        <div style="flex: 1 1 230px; min-width: 0; display: flex; flex-direction: column; gap: 8px; border-top: 4px solid #111; padding-top: 14px"><div style="font-weight: 800; font-size: 13px; letter-spacing: 0.1em">BƯỚC 1</div><div style="font-weight: 800; font-size: 16px">Kiểm tra file</div><div style="font-size: 14px; line-height: 1.6">Xem nét cắt, kích thước và chất liệu, báo lại nếu cần chỉnh.</div></div>
        <div style="flex: 1 1 230px; min-width: 0; display: flex; flex-direction: column; gap: 8px; border-top: 4px solid #111; padding-top: 14px"><div style="font-weight: 800; font-size: 13px; letter-spacing: 0.1em">BƯỚC 2</div><div style="font-weight: 800; font-size: 16px">Báo giá và duyệt mẫu</div><div style="font-size: 14px; line-height: 1.6">Gửi giá và bản xem trước. Bạn xác nhận rồi mới cắt.</div></div>
        <div style="flex: 1 1 230px; min-width: 0; display: flex; flex-direction: column; gap: 8px; border-top: 4px solid #111; padding-top: 14px"><div style="font-weight: 800; font-size: 13px; letter-spacing: 0.1em">BƯỚC 3</div><div style="font-weight: 800; font-size: 16px">Cắt và phủ lớp định hình</div><div style="font-size: 14px; line-height: 1.6">Cắt bằng máy, bóc phần thừa, phủ lớp định hình giữ nguyên vị trí chữ.</div></div>
        <div style="flex: 1 1 230px; min-width: 0; display: flex; flex-direction: column; gap: 8px; border-top: 4px solid #111; padding-top: 14px"><div style="font-weight: 800; font-size: 13px; letter-spacing: 0.1em">BƯỚC 4</div><div style="font-weight: 800; font-size: 16px">Giao hàng</div><div style="font-size: 14px; line-height: 1.6">Đóng gói phẳng, gửi toàn quốc. Thời gian dự kiến: [SỐ NGÀY].</div></div>
      </div>
    </div>
  </div>

  <!-- Hỏi đáp -->
  <div style="padding: 52px 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 24px">
      <h2 style="margin: 0; font-size: 30px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 900">Câu hỏi thường gặp</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 20px">
        <div style="flex: 1 1 300px; min-width: 0; background: #fff; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 8px"><div style="font-weight: 800; font-size: 16px">Tôi không có file thiết kế thì sao?</div><div style="font-size: 14px; line-height: 1.7">Mô tả nội dung, font mong muốn và kích thước trong phần ghi chú. Bên mình dựng mẫu để bạn duyệt trước khi cắt.</div></div>
        <div style="flex: 1 1 300px; min-width: 0; background: #fff; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 8px"><div style="font-weight: 800; font-size: 16px">Chữ nhỏ nhất cắt được là bao nhiêu?</div><div style="font-size: 14px; line-height: 1.7">Phụ thuộc chất liệu và độ mảnh của nét chữ. Giới hạn hiện tại: [KÍCH THƯỚC TỐI THIỂU]. Gửi file để bên mình kiểm tra.</div></div>
        <div style="flex: 1 1 300px; min-width: 0; background: #fff; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 8px"><div style="font-weight: 800; font-size: 16px">Có nhận đơn số lượng lớn không?</div><div style="font-size: 14px; line-height: 1.7">Có. Ghi số lượng trong form, bên mình báo giá theo từng mốc.</div></div>
      </div>
    </div>
  </div>

</Layout>
<script>
  const $ = (id) => document.getElementById(id);
  const okExt = ['ai', 'svg', 'pdf', 'cdr', 'eps', 'dxf', 'png', 'jpg', 'jpeg'];
  const maxSize = 20 * 1024 * 1024;
  let files = [];
  const fmt = (b) => (b < 1024 ? b + ' B' : b < 1048576 ? (b / 1024).toFixed(0) + ' KB' : (b / 1048576).toFixed(1) + ' MB');
  function showErrors(errs) {
    const box = $('f-errors');
    box.innerHTML = '';
    errs.forEach((t) => { const d = document.createElement('div'); d.textContent = t; box.appendChild(d); });
    box.hidden = errs.length === 0;
  }
  function setStatus(t) { const s = $('f-status'); s.textContent = t; s.hidden = !t; }
  function renderFiles() {
    const box = $('f-list');
    box.innerHTML = '';
    files.forEach((f, i) => {
      const row = document.createElement('div');
      row.style.cssText = 'display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #F6F4EF; border-radius: 12px; padding: 10px 14px';
      const info = document.createElement('div');
      info.style.cssText = 'min-width: 0; display: flex; flex-direction: column; gap: 2px';
      const n = document.createElement('span'); n.style.cssText = 'font-weight: 700; font-size: 14px; overflow-wrap: anywhere'; n.textContent = f.name;
      const s = document.createElement('span'); s.style.cssText = 'font-size: 12px'; s.textContent = fmt(f.size);
      info.append(n, s);
      const btn = document.createElement('button');
      btn.type = 'button'; btn.textContent = 'Bỏ'; btn.setAttribute('aria-label', 'Bỏ file ' + f.name);
      btn.style.cssText = 'font: inherit; font-weight: 700; font-size: 13px; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 2px solid #111; background: transparent; color: #111; cursor: pointer; flex: none';
      btn.addEventListener('click', () => { files = files.filter((_, j) => j !== i); setStatus(''); renderFiles(); });
      row.append(info, btn);
      box.appendChild(row);
    });
  }
  function addFiles(list) {
    const errors = [];
    list.forEach((f) => {
      const ext = (f.name.split('.').pop() || '').toLowerCase();
      if (!okExt.includes(ext)) { errors.push('"' + f.name + '": định dạng chưa được nhận.'); return; }
      if (f.size > maxSize) { errors.push('"' + f.name + '": lớn hơn 20 MB.'); return; }
      if (files.some((x) => x.name === f.name && x.size === f.size)) return;
      if (files.length >= 5) { errors.push('"' + f.name + '": đã đủ 5 file.'); return; }
      files.push(f);
    });
    showErrors(errors); setStatus(''); renderFiles();
  }
  const drop = $('drop');
  drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.style.background = '#FFD60A'; });
  drop.addEventListener('dragleave', () => { drop.style.background = '#F6F4EF'; });
  drop.addEventListener('drop', (e) => {
    e.preventDefault(); drop.style.background = '#F6F4EF';
    addFiles(e.dataTransfer && e.dataTransfer.files ? Array.from(e.dataTransfer.files) : []);
  });
  $('f-file').addEventListener('change', (e) => { addFiles(Array.from(e.target.files || [])); try { e.target.value = ''; } catch (err) {} });
  function val(id) { return $(id).value.trim(); }
  function buildText() {
    return [
      'YÊU CẦU CẮT DECAL THEO YÊU CẦU',
      'Họ tên: ' + (val('s-ten') || '—'),
      'SĐT / Zalo: ' + (val('s-sdt') || '—'),
      'Chất liệu: ' + $('s-cl').value,
      'Màu decal: ' + (val('s-mau') || '—'),
      'Kích thước (rộng x cao, cm): ' + (val('s-rong') || '—') + ' x ' + (val('s-cao') || '—'),
      'Số lượng: ' + (val('s-sl') || '1'),
      'Lớp định hình: ' + ($('s-lop').checked ? 'Có' : 'Không'),
      'File đính kèm: ' + (files.map((f) => f.name).join(', ') || '—'),
      'Ghi chú: ' + (val('s-note') || '—')
    ].join('\n');
  }
  function check() {
    const errors = [];
    if (!val('s-ten')) errors.push('Vui lòng nhập họ tên.');
    if (!val('s-sdt')) errors.push('Vui lòng nhập số điện thoại hoặc Zalo.');
    if (!files.length) errors.push('Vui lòng chọn ít nhất một file thiết kế.');
    showErrors(errors);
    return errors.length === 0;
  }
  $('btn-upload').addEventListener('click', async () => {
    if (!check()) return;
    const button = $('btn-upload');
    button.disabled = true;
    button.textContent = 'Đang gửi file...';
    setStatus('Đang tải file và yêu cầu lên hệ thống, vui lòng giữ trang này mở.');
    try {
      const form = new FormData();
      form.append('name', val('s-ten'));
      form.append('phone', val('s-sdt'));
      form.append('material', $('s-cl').value);
      form.append('color', val('s-mau'));
      form.append('width', val('s-rong'));
      form.append('height', val('s-cao'));
      form.append('quantity', val('s-sl'));
      form.append('transferLayer', $('s-lop').checked ? 'yes' : 'no');
      form.append('note', val('s-note'));
      form.append('website', val('s-website'));
      files.forEach(file => form.append('files', file, file.name));
      const response = await fetch('/api/bao-gia', { method: 'POST', body: form });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Không thể gửi yêu cầu.');
      setStatus('Đã nhận yêu cầu #' + result.id + '. Vui lòng lưu mã này để đối chiếu.');
      files = []; renderFiles(); showErrors([]);
    } catch (error) {
      setStatus('Chưa gửi thành công: ' + (error instanceof Error ? error.message : 'Lỗi kết nối') + '. Bạn có thể dùng email hoặc Zalo bên cạnh.');
    } finally {
      button.disabled = false; button.textContent = 'Gửi báo giá kèm file';
    }
  });
  $('btn-mail').addEventListener('click', () => {
    if (!check()) return;
    const href = 'mailto:hi@idecal.vn?subject=' + encodeURIComponent('Yêu cầu cắt decal theo yêu cầu') + '&body=' + encodeURIComponent(buildText() + '\n\n(Vui lòng đính kèm các file đã chọn.)');
    setStatus('Đang mở email với thông tin đơn. Hãy đính kèm ' + files.length + ' file đã chọn rồi gửi. Nếu email không mở, bấm "Sao chép nội dung gửi Zalo".');
    window.location.href = href;
  });
  $('btn-copy').addEventListener('click', () => {
    if (!check()) return;
    const text = buildText();
    const done = () => setStatus('Đã sao chép nội dung đơn. Dán vào Zalo 0866077040 và gửi kèm ' + files.length + ' file đã chọn.');
    const fail = () => setStatus('Trình duyệt không cho sao chép tự động. Hãy chép tay thông tin đơn rồi gửi cùng file qua Zalo.');
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fail);
      else fail();
    } catch (err) { fail(); }
  });
</script>