---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Không tìm thấy trang | CatDecal.vn">
  <div style="max-width: 760px; margin: 0 auto; padding: 64px 24px 96px; display: flex; flex-direction: column; gap: 16px">
    <h1 style="margin: 0; font-size: 40px; letter-spacing: -0.03em; font-weight: 900">Không tìm thấy trang này</h1>
    <p style="margin: 0; font-size: 16px; line-height: 1.7">Đường dẫn có thể đã đổi hoặc không còn tồn tại.</p>
    <div><a href="/" style="background: #FFD60A; color: #111; text-decoration: none; font-weight: 800; padding: 14px 26px; border-radius: 999px; display: inline-block">Về trang chủ</a></div>
  </div>
</Layout>
