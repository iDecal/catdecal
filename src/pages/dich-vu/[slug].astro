---
import Layout from '../../layouts/Layout.astro';
import services from '../../data/services.json';
export function getStaticPaths() { return services.map(service=>({params:{slug:service.slug},props:{service}})); }
const {service}=Astro.props;
---
<Layout title={`${service.name} tại TP.HCM | CatDecal.vn`} description={service.short} active="service">
<main class="service-detail"><a class="back" href="/dich-vu/">← Tất cả dịch vụ</a><div class="hero"><div><div class="tag">GIA CÔNG THEO YÊU CẦU · TP.HCM</div><h1>{service.name}</h1><p>{service.short} Gửi file hoặc mô tả mong muốn để được kiểm tra và xác nhận phương án gia công phù hợp.</p><div class="actions"><a class="primary" href="/dich-vu/#yeu-cau">Gửi file nhận báo giá →</a><a class="secondary" href="tel:0866077040">Gọi 0866 077 040</a></div></div><img src={service.image} alt={'Ảnh minh họa '+service.name}/></div><section><p class="tag">HÌNH MẪU ỨNG DỤNG</p><h2>Dịch vụ này phù hợp để làm gì?</h2><div class="examples">{service.examples.map((e,i)=><div class="example"><span>0{i+1}</span><strong>{e}</strong><p>Mẫu ứng dụng tham khảo; có thể điều chỉnh theo file và kích thước thực tế của khách.</p></div>)}</div></section><section class="process"><div><p class="tag">QUY TRÌNH</p><h2>Từ yêu cầu đến thành phẩm</h2><p>Đội ngũ xác nhận nội dung, vật liệu và chi phí trước khi tiến hành sản xuất.</p></div><ol><li>Gửi file thiết kế hoặc mô tả yêu cầu.</li><li>Kiểm tra file, tư vấn chất liệu và báo giá.</li><li>Xác nhận phương án cắt và sản xuất.</li><li>Nhận tại TP.HCM hoặc giao toàn quốc.</li></ol></section><div class="bottom"><h2>Cần cắt decal theo kích thước riêng?</h2><p>Gửi file để nhận tư vấn và báo giá phù hợp với yêu cầu của bạn.</p><a href="/dich-vu/#yeu-cau">Gửi yêu cầu báo giá ↗</a></div></main>
</Layout>
<style>
.service-detail{max-width:1200px;margin:auto;padding:36px 24px 90px}.back{font-weight:800}.hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:44px;margin:38px 0 75px}.hero img{width:100%;border-radius:25px;aspect-ratio:16/11;object-fit:cover}.tag{font-size:12px;font-weight:900;letter-spacing:.13em}.hero h1{font-size:clamp(35px,4.5vw,58px);letter-spacing:-.04em;line-height:1.1}.hero p{font-size:17px;line-height:1.8}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:27px}.actions a,.bottom a{font-weight:900;text-decoration:none;border-radius:99px;padding:15px 22px}.primary{background:#111;color:white}.secondary{border:2px solid #111;color:#111}.service-detail h2{font-size:clamp(26px,3vw,37px);letter-spacing:-.03em}.examples{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.example{background:#fff;border-radius:19px;padding:25px}.example span{display:block;background:#ffdf31;border-radius:9px;padding:8px 10px;width:max-content;font-weight:900}.example strong{display:block;font-size:20px;margin:19px 0 8px}.example p{line-height:1.7;color:#444}.process{display:grid;grid-template-columns:1fr 1.2fr;gap:50px;margin:70px 0}.process p{line-height:1.7}.process ol{background:#fff;border-radius:24px;padding:26px 30px 26px 53px;line-height:2.5;font-weight:700}.bottom{background:#ffdd22;border-radius:25px;padding:36px 40px}.bottom p{line-height:1.7}.bottom a{display:inline-block;background:#111;color:white;margin-top:10px}@media(max-width:750px){.service-detail{padding:28px 16px 60px}.hero,.process{grid-template-columns:1fr;gap:20px;margin:30px 0 55px}.examples{grid-template-columns:1fr}.bottom{padding:25px}}
</style>