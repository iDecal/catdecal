---
import Layout from '../../layouts/Layout.astro';
import services from '../../data/services.json';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
---
<Layout title={`${service.name} tại TP.HCM | CatDecal.vn`} description={service.short} active="service">
  <main style="max-width:1000px;margin:0 auto;padding:44px 24px 90px">
    <a href="/dich-vu/" style="font-weight:700">← Tất cả dịch vụ</a>
    <p style="margin-top:32px;font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.12em">Gia công theo yêu cầu · TP.HCM · Giao hàng toàn quốc</p>
    <h1 style="font-size:clamp(34px,5vw,56px);line-height:1.1;letter-spacing:-.03em">{service.name}</h1>
    <p style="font-size:19px;line-height:1.8;max-width:720px">{service.short}</p>
    <div style="background:#fff;padding:28px;border-radius:24px;margin:32px 0">
      <h2 style="margin-top:0">Quy trình thực hiện</h2>
      <ol style="line-height:2"><li>Gửi file hoặc mô tả ý tưởng, kích thước và số lượng.</li><li>CatDecal kiểm tra khả năng gia công, tư vấn vật liệu và báo giá.</li><li>Duyệt nội dung, xác nhận đơn và tiến hành cắt decal.</li><li>Nhận hàng tại TP.HCM hoặc giao hàng toàn quốc.</li></ol>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap"><a href="/dich-vu/#yeu-cau" style="background:#111;color:white;padding:16px 24px;border-radius:999px;text-decoration:none;font-weight:800">Gửi file nhận báo giá</a><a href="tel:0866077040" style="border:2px solid #111;padding:14px 24px;border-radius:999px;text-decoration:none;font-weight:800;color:#111">Gọi 0866 077 040</a></div>
  </main>
</Layout>
